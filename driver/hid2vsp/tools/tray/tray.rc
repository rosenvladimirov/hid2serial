#include <windows.h>
#include "resource.h"

IDI_TRAY ICON "tray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rosen Vladimirov"
            VALUE "FileDescription",  "hid2vsp tray applet"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "hid2vsp_tray"
            VALUE "OriginalFilename", "hid2vsp_tray.exe"
            VALUE "ProductName",      "hid2vsp"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
