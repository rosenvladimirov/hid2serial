[Unit]
Description=hid2serial — HID barcode reader to virtual serial port
Documentation=https://github.com/rosenvladimirov/hid2serial
After=systemd-udevd.service local-fs.target
Wants=systemd-udevd.service
# StartLimit doesn't trip — restart loops are EXPECTED when the BLE
# scanner is asleep and /dev/input/event* doesn't exist. The watchdog
# in the CLI exits 5 when no readers are alive; systemd respawns and
# tries again. When the scanner wakes (via trigger button or BLE
# keep-alive), one of the restart cycles successfully grabs the
# device.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/hid2serial run --config /etc/hid2serial/config.yaml
Restart=always
RestartSec=3
# Needs evdev access. Either run as root, OR put the service user in
# the `input` group AND deploy the udev rule under service/udev/.
User=root
Group=root
# The pty + symlink need /dev write — keep this minimal otherwise.
PrivateDevices=no
ProtectSystem=strict
ReadWritePaths=/dev /var/log
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
